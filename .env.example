TELEGRAM_CHANNEL=maddysontg
POLL_SECONDS=300
DATA_DIR=./data
# Initial polling starts at the current end of the feed. Import history separately.
YOUTUBE_PRIVACY=public
# Set by `auth youtube` after choosing the dedicated channel.
# YOUTUBE_CHANNEL_ID=UC...
# Supply a Google Desktop OAuth client JSON using auth youtube --client <path>.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Enable delayed topic titles through the local Codex topic service.
# TOPICS_URL=http://127.0.0.1:11435
# Topic server settings (run `bun run topics` separately):
# CODEX_PATH=codex
# TOPIC_MODEL=gpt-6.1-sol
# TOPIC_EXTRACT_MODEL=gpt-6.1-sol
# TOPIC_REVIEW_MODEL=gpt-6.1-sol
# TOPICS_DATA_DIR=./data/topics
# PEOPLE_FILE=./assets/people.json
# TG_PATH=tg
# Required on the topic server: select an existing authorized Telegram profile.
# TG_PROFILE=personal
