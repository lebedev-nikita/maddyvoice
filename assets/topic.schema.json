          "observed": { "type": "string", "minLength": 1, "maxLength": 80 },
          "suggested": { "type": "string", "minLength": 1, "maxLength": 80 },
          "evidence": { "type": "string", "minLength": 2, "maxLength": 600 },
          "sources": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "required": ["observed", "suggested", "evidence", "sources"],
        "additionalProperties": false
      }
    }
  },
  "required": ["topic", "subjects", "candidates"],
  "additionalProperties": false
}
