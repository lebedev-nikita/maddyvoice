[Unit]
Description=Maddyvoice topic generator through CLIProxyAPI
Wants=network-online.target
After=network-online.target cliproxyapi.service

[Service]
Type=simple
User=pi
Group=maddyvoice
WorkingDirectory=/var/lib/maddyvoice-topics
Environment=HOME=/var/lib/maddyvoice-topics
Environment=OPENAI_BASE_URL=http://127.0.0.1:8317/v1
Environment=TOPIC_MODEL=gpt-6.1-sol
Environment=TOPIC_FILTER_MODEL=gpt-6-luna
Environment=TOPIC_EXTRACT_MODEL=gpt-6.1-sol
Environment=TOPIC_REVIEW_MODEL=gpt-6.1-sol
Environment=TG_PROFILE=personal
Environment=TG_PATH=/opt/maddyvoice/bin/tg
Environment=XDG_CONFIG_HOME=/home/pi/.config
Environment=XDG_DATA_HOME=/home/pi/.local/share
Environment=XDG_CACHE_HOME=/home/pi/.cache
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=TOPICS_DATA_DIR=/var/lib/maddyvoice-topics
EnvironmentFile=-/etc/maddyvoice-topics.env
ExecStart=/opt/maddyvoice/bin/bun /opt/maddyvoice/src/+topics-server.ts
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=30
StateDirectory=maddyvoice-topics
StateDirectoryMode=0700
UMask=0077
Nice=10
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/pi/.config/tg-cli /home/pi/.local/share/tg-cli /home/pi/.local/share/WireCat /home/pi/.cache/tg-cli
BindReadOnlyPaths=/home/pi/.bun/install/global/node_modules
BindReadOnlyPaths=-/run/user/1000/bus
ReadWritePaths=/var/lib/maddyvoice-topics /home/pi/.config/tg-cli /home/pi/.local/share/tg-cli /home/pi/.local/share/WireCat /home/pi/.cache/tg-cli

[Install]
WantedBy=multi-user.target
