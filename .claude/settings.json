{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run check)",
      "Bash(bun run test)",
      "Bash(bun run analyze)",
      "Bash(bun run build)",
      "Bash(bunx tsgo --noEmit)",
      "Bash(bunx vp check:*)",
      "Bash(bunx vp fmt:*)",
      "Bash(bunx vp test:*)",
      "Bash(bun scripts/+media-smoke.ts)",
      "Bash(just check)",
      "Bash(just test)"
    ],
    "deny": ["Read(./.env)", "Read(./data/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -I{} bunx vp fmt --no-error-on-unmatched-pattern {} >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
